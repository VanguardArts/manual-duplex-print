#!/bin/bash
#
# manual-duplex — a "fake duplexer wizard" for single-sided printers on Linux
#
# Prints odd pages of a PDF, waits for the printer to finish, prompts you
# to flip the stack, then prints the even pages on the backs.
#
# Copyright (C) 2026 Vanguard Arts SRL
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Usage:
#   manual-duplex [options] [file]
#
# Options:
#   -p, --printer NAME   CUPS queue to use (default: $DUPLEX_PRINTER or
#                        the system default printer)
#   -s, --short-edge     flip instructions for short-edge binding
#   -h, --help           show this help
#   -V, --version        show version
#
# Supported formats:
#   PDF natively. Office documents are converted to PDF automatically
#   when a converter is available:
#     - LibreOffice (doc, docx, odt, ods, odp, ppt, pptx, xls, xlsx, rtf, …)
#     - pandoc      (docx, odt, rtf, md, html, …) — lightweight fallback
#   If neither is installed, non-PDF files are rejected with guidance.
#
# Dependencies: bash, CUPS client tools (lp, lpstat),
#               kdialog or zenity for GUI prompts (optional — falls
#               back to terminal prompts when neither is available),
#               LibreOffice or pandoc (optional — only for non-PDF files).

set -u
VERSION="1.2.0"
PROG="manual-duplex"

# ---------------------------------------------------------------- defaults --
PRINTER="${DUPLEX_PRINTER:-}"
BINDING="long"
FILE=""

# ------------------------------------------------------------- arg parsing --
while [ $# -gt 0 ]; do
    case "$1" in
        -p|--printer)    PRINTER="${2:-}"; shift 2 ;;
        -s|--short-edge) BINDING="short"; shift ;;
        -h|--help)
            sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        -V|--version)
            echo "$PROG $VERSION"
            exit 0 ;;
        -*)  echo "$PROG: unknown option: $1" >&2; exit 2 ;;
        *)   FILE="$1"; shift ;;
    esac
done

# --------------------------------------------------------- printer resolve --
if [ -z "$PRINTER" ]; then
    PRINTER=$(lpstat -d 2>/dev/null | sed 's/^system default destination: //')
fi

# ------------------------------------------------------------ dialog layer --
if command -v kdialog >/dev/null 2>&1; then
    GUI="kdialog"
elif command -v zenity >/dev/null 2>&1; then
    GUI="zenity"
else
    GUI="none"
fi

dlg_yesno() {  # $1 = message; returns 0 on Yes
    case "$GUI" in
        kdialog) kdialog --yesno "$1" ;;
        zenity)  zenity --question --width=480 --text="$1" ;;
        none)    printf '%s\n\n[y/N] ' "$1"; read -r a; [ "$a" = "y" ] || [ "$a" = "Y" ] ;;
    esac
}

dlg_error() {
    case "$GUI" in
        kdialog) kdialog --error "$1" ;;
        zenity)  zenity --error --width=400 --text="$1" ;;
        none)    echo "ERROR: $1" >&2 ;;
    esac
}

notify() {  # $1 = message, $2 = seconds
    case "$GUI" in
        kdialog) kdialog --passivepopup "$1" "$2" ;;
        zenity)  zenity --notification --text="$1" 2>/dev/null || true ;;
        none)    echo "$1" ;;
    esac
}

pick_file() {
    case "$GUI" in
        kdialog) kdialog --getopenfilename "$HOME" "application/pdf application/msword application/vnd.openxmlformats-officedocument.wordprocessingml.document application/vnd.oasis.opendocument.text application/vnd.oasis.opendocument.presentation application/vnd.oasis.opendocument.spreadsheet application/vnd.ms-powerpoint application/vnd.openxmlformats-officedocument.presentationml.presentation" --title "Manual Duplex: choose a document" ;;
        zenity)  zenity --file-selection --title="Manual Duplex: choose a document" --file-filter="Printable documents | *.pdf *.doc *.docx *.odt *.ods *.odp *.ppt *.pptx *.xls *.xlsx *.rtf" ;;
        none)    printf 'Path to PDF: '; read -r f; echo "$f" ;;
    esac
}

# -------------------------------------------------------------- file check --
if [ -z "$FILE" ]; then
    FILE=$(pick_file)
    [ -z "$FILE" ] && exit 0
fi
if [ ! -f "$FILE" ]; then
    dlg_error "File not found: $FILE"
    exit 1
fi

# ------------------------------------------- convert non-PDF formats to PDF --
ORIG_FILE="$FILE"
if [[ "${FILE,,}" != *.pdf ]]; then
    TMPDIR_CONV=$(mktemp -d)
    trap 'rm -rf "$TMPDIR_CONV"' EXIT
    CONVERTED=""
    BASE="$(basename "$FILE")"
    EXT="${FILE##*.}"; EXT="${EXT,,}"

    notify "Converting $BASE to PDF…" 5

    # Converter 1: LibreOffice (handles everything MS Office + ODF)
    SOFFICE=$(command -v libreoffice || command -v soffice || true)
    if [ -n "$SOFFICE" ]; then
        if "$SOFFICE" --headless --convert-to pdf --outdir "$TMPDIR_CONV" "$FILE" >/dev/null 2>&1; then
            CONVERTED=$(find "$TMPDIR_CONV" -maxdepth 1 -name '*.pdf' | head -1)
        fi
    fi

    # Converter 2: pandoc (lightweight; good for text documents)
    if [ -z "$CONVERTED" ] && command -v pandoc >/dev/null 2>&1; then
        case "$EXT" in
            docx|odt|rtf|md|markdown|html|htm|epub|txt)
                OUT="$TMPDIR_CONV/converted.pdf"
                if pandoc "$FILE" -o "$OUT" >/dev/null 2>&1 && [ -s "$OUT" ]; then
                    CONVERTED="$OUT"
                fi ;;
        esac
    fi

    if [ -z "$CONVERTED" ]; then
        dlg_error "Cannot convert '$BASE' to PDF.\n\nInstall LibreOffice (full office support) or pandoc\n(text documents), or export the file to PDF from your\napplication and try again."
        exit 1
    fi
    FILE="$CONVERTED"
fi

# ----------------------------------------------------------- printer check --
if [ -z "$PRINTER" ] || ! lpstat -p "$PRINTER" >/dev/null 2>&1; then
    dlg_error "Printer '$PRINTER' not found.\n\nSet one with --printer, the DUPLEX_PRINTER environment variable,\nor configure a system default printer."
    exit 1
fi

# ---------------------------------------------------------- flip wording ----
if [ "$BINDING" = "short" ]; then
    FLIP="Flip it top-to-bottom (short-edge binding)."
else
    FLIP="Flip it over like turning a book page (long edge stays put)."
fi

# ------------------------------------------------------------------ intro --
if ! dlg_yesno "Manual Duplex Printing\n\nFile: $(basename "$ORIG_FILE")\nPrinter: $PRINTER\n\nStep 1: all ODD pages will print now.\nStep 2: you'll flip the stack and reinsert it.\nStep 3: all EVEN pages print on the backs.\n\nTip: with an untested printer, try a 4-page document first.\n\nContinue?"; then
    exit 0
fi

# ---------------------------------------------------------- pass 1: odds ---
if ! lp -d "$PRINTER" -o page-set=odd -o sides=one-sided -- "$FILE"; then
    dlg_error "Failed to submit the odd-page print job."
    exit 1
fi

# --------------------------------------------- wait until printer is done --
notify "Printing odd pages…" 5
while [ -n "$(lpstat -o "$PRINTER" 2>/dev/null)" ]; do
    sleep 2
done
sleep 3   # let the last page physically exit

# ----------------------------------------------------------- flip prompt ---
if ! dlg_yesno "Odd pages are done.\n\nNow:\n1. Take the whole stack from the output tray AS IS (do not reorder).\n2. $FLIP\n3. Put it back in the feed tray, printed side facing the way your printer expects (blank side toward the print head), top edge up.\n\nClick Yes when the paper is loaded — even pages will print.\nClick No to cancel (the backs will not be printed)."; then
    exit 0
fi

# --------------------------------------------------------- pass 2: evens ---
if ! lp -d "$PRINTER" -o page-set=even -o sides=one-sided -- "$FILE"; then
    dlg_error "Failed to submit the even-page print job."
    exit 1
fi

notify "Printing even pages on the backs. Done!" 8
