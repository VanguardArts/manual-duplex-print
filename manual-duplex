#!/bin/bash
#
# manual-duplex — a "fake duplexer wizard" for single-sided printers on Linux
#
# Prints odd pages of a PDF, waits for the printer to finish, prompts you
# to flip the stack, then prints the even pages on the backs.
#
# Copyright (C) 2026 Vanguard Arts SRL
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Usage:
#   manual-duplex [options] [file]
#
# Options:
#   -p, --printer NAME   CUPS queue to use (default: $DUPLEX_PRINTER or
#                        the system default printer)
#   -s, --short-edge     flip instructions for short-edge binding
#   -h, --help           show this help
#   -V, --version        show version
#
# Supported formats:
#   PDF natively (CUPS is PDF-centric: the odd/even page-splitting is
#   done by the pdftopdf filter, which only understands PDF). Office
#   documents must first be RENDERED to PDF by an external engine —
#   Linux's print stack has no built-in office renderer (unlike
#   Windows, where each app draws its own pages). Converters used:
#     - LibreOffice (doc, docx, odt, ods, odp, ppt, pptx, xls, xlsx, rtf, …)
#     - pandoc      (docx, odt, rtf, md, html, …) — lightweight fallback
#   If neither is installed, the wizard offers to install one for you.
#
# Dependencies: bash, CUPS client tools (lp, lpstat),
#               kdialog or zenity for GUI prompts (optional — falls
#               back to terminal prompts when neither is available),
#               LibreOffice or pandoc (optional — only for non-PDF files;
#               installable on demand from the wizard).

set -u
VERSION="1.3.2"
PROG="manual-duplex"

# ---------------------------------------------------------------- defaults --
PRINTER="${DUPLEX_PRINTER:-}"
BINDING="long"
FILE=""

# ------------------------------------------------------------- arg parsing --
while [ $# -gt 0 ]; do
    case "$1" in
        -p|--printer)    PRINTER="${2:-}"; shift 2 ;;
        -s|--short-edge) BINDING="short"; shift ;;
        -h|--help)
            sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        -V|--version)
            echo "$PROG $VERSION"
            exit 0 ;;
        -*)  echo "$PROG: unknown option: $1" >&2; exit 2 ;;
        *)   FILE="$1"; shift ;;
    esac
done

# --------------------------------------------------------- printer resolve --
if [ -z "$PRINTER" ]; then
    PRINTER=$(lpstat -d 2>/dev/null | sed 's/^system default destination: //')
fi

# ------------------------------------------------------------ dialog layer --
if command -v kdialog >/dev/null 2>&1; then
    GUI="kdialog"
elif command -v zenity >/dev/null 2>&1; then
    GUI="zenity"
else
    GUI="none"
fi

dlg_yesno() {  # $1 = message; returns 0 on Yes
    case "$GUI" in
        kdialog) kdialog --yesno "$1" ;;
        zenity)  zenity --question --width=480 --text="$1" ;;
        none)    printf '%s\n\n[y/N] ' "$1"; read -r a; [ "$a" = "y" ] || [ "$a" = "Y" ] ;;
    esac
}

dlg_error() {
    case "$GUI" in
        kdialog) kdialog --error "$1" ;;
        zenity)  zenity --error --width=400 --text="$1" ;;
        none)    echo "ERROR: $1" >&2 ;;
    esac
}

notify() {  # $1 = message, $2 = seconds
    case "$GUI" in
        kdialog) kdialog --passivepopup "$1" "$2" ;;
        zenity)  zenity --notification --text="$1" 2>/dev/null || true ;;
        none)    echo "$1" ;;
    esac
}

pick_file() {
    case "$GUI" in
        kdialog) kdialog --getopenfilename "$HOME" "application/pdf application/msword application/vnd.openxmlformats-officedocument.wordprocessingml.document application/vnd.oasis.opendocument.text application/vnd.oasis.opendocument.presentation application/vnd.oasis.opendocument.spreadsheet application/vnd.ms-powerpoint application/vnd.openxmlformats-officedocument.presentationml.presentation" --title "Manual Duplex: choose a document" ;;
        zenity)  zenity --file-selection --title="Manual Duplex: choose a document" --file-filter="Printable documents | *.pdf *.doc *.docx *.odt *.ods *.odp *.ppt *.pptx *.xls *.xlsx *.rtf" ;;
        none)    printf 'Path to PDF: '; read -r f; echo "$f" ;;
    esac
}

# -------------------------------------------------------------- file check --
if [ -z "$FILE" ]; then
    FILE=$(pick_file)
    [ -z "$FILE" ] && exit 0
fi
if [ ! -f "$FILE" ]; then
    dlg_error "File not found: $FILE"
    exit 1
fi

# -------------------------------------------------- dependency installation --
# Install a logical package via this distro's package manager (with a
# graphical pkexec password prompt). $1 = libreoffice|pandoc
install_pkg() {
    local pkg="$1"
    if command -v apt-get >/dev/null 2>&1; then
        pkexec apt-get install -y "$pkg"
    elif command -v dnf >/dev/null 2>&1; then
        pkexec dnf install -y "$pkg"
    elif command -v zypper >/dev/null 2>&1; then
        pkexec zypper install -y "$pkg"
    elif command -v pacman >/dev/null 2>&1; then
        [ "$pkg" = "libreoffice" ] && pkg="libreoffice-fresh"
        pkexec pacman -S --noconfirm "$pkg"
    else
        return 1
    fi
}

# Ask the user which converter to install. Echoes: libreoffice | pandoc | cancel
offer_converter_install() {  # $1 = message
    case "$GUI" in
        kdialog)
            kdialog --yesnocancel "$1" \
                --yes-label "Install LibreOffice" \
                --no-label "Install pandoc" \
                --cancel-label "Cancel"
            case $? in
                0) echo libreoffice ;;
                1) echo pandoc ;;
                *) echo cancel ;;
            esac ;;
        zenity)
            local out rc
            out=$(zenity --question --width=520 --text="$1" \
                    --ok-label="Install LibreOffice" \
                    --cancel-label="Cancel" \
                    --extra-button="Install pandoc" 2>/dev/null)
            rc=$?
            if [ $rc -eq 0 ]; then echo libreoffice
            elif [ "$out" = "Install pandoc" ]; then echo pandoc
            else echo cancel
            fi ;;
        none)
            printf '%s\n\n[L]ibreOffice  [p]andoc  [c]ancel: ' "$1"
            local a; read -r a
            case "$a" in
                [Ll]*) echo libreoffice ;;
                [Pp]*) echo pandoc ;;
                *) echo cancel ;;
            esac ;;
    esac
}

# ------------------------------------------- convert non-PDF formats to PDF --
ORIG_FILE="$FILE"
if [[ "${FILE,,}" != *.pdf ]]; then
    TMPDIR_CONV=$(mktemp -d)
    trap 'rm -rf "$TMPDIR_CONV"' EXIT
    CONVERTED=""
    BASE="$(basename "$FILE")"
    EXT="${FILE##*.}"; EXT="${EXT,,}"

    notify "Converting $BASE to PDF…" 5

    while [ -z "$CONVERTED" ]; do
        # Converter 1: LibreOffice (handles everything MS Office + ODF)
        SOFFICE=$(command -v libreoffice || command -v soffice || true)
        if [ -n "$SOFFICE" ]; then
            if "$SOFFICE" --headless --convert-to pdf --outdir "$TMPDIR_CONV" "$FILE" >/dev/null 2>&1; then
                CONVERTED=$(find "$TMPDIR_CONV" -maxdepth 1 -name '*.pdf' | head -1)
            fi
        fi

        # Converter 2: pandoc (lightweight; good for text documents)
        if [ -z "$CONVERTED" ] && command -v pandoc >/dev/null 2>&1; then
            case "$EXT" in
                docx|odt|rtf|md|markdown|html|htm|epub|txt)
                    OUT="$TMPDIR_CONV/converted.pdf"
                    if pandoc "$FILE" -o "$OUT" >/dev/null 2>&1 && [ -s "$OUT" ]; then
                        CONVERTED="$OUT"
                    fi ;;
            esac
        fi

        [ -n "$CONVERTED" ] && break

        # No converter available (or conversion failed) — offer to install one
        CHOICE=$(offer_converter_install "'$BASE' is not a PDF, and no document converter is available to render it.\n\n(Linux's print system only understands PDF natively — office\ndocuments must be rendered to PDF first.)\n\n• LibreOffice — full office suite, best fidelity, ~500 MB\n• pandoc — lightweight (~30 MB), text documents only\n\nInstall one now, or cancel and export a PDF yourself?")
        case "$CHOICE" in
            libreoffice|pandoc)
                notify "Installing $CHOICE…" 5
                if ! install_pkg "$CHOICE"; then
                    dlg_error "Installation of '$CHOICE' failed or was cancelled."
                    exit 1
                fi ;;
            *)  exit 0 ;;
        esac
    done
    FILE="$CONVERTED"
fi

# ----------------------------------------------------------- printer check --
if [ -z "$PRINTER" ] || ! lpstat -p "$PRINTER" >/dev/null 2>&1; then
    dlg_error "Printer '$PRINTER' not found.\n\nSet one with --printer, the DUPLEX_PRINTER environment variable,\nor configure a system default printer."
    exit 1
fi

# ---------------------------------------------------------- flip wording ----
if [ "$BINDING" = "short" ]; then
    FLIP="Flip it top-to-bottom (short-edge binding)."
else
    FLIP="Flip it over like turning a book page (long edge stays put)."
fi

# ------------------------------------------------------------------ intro --
if ! dlg_yesno "Manual Duplex Printing\n\nFile: $(basename "$ORIG_FILE")\nPrinter: $PRINTER\n\nStep 1: all ODD pages will print now.\nStep 2: you'll flip the stack and reinsert it.\nStep 3: all EVEN pages print on the backs.\n\nTip: with an untested printer, try a 4-page document first.\n\nContinue?"; then
    exit 0
fi

# ----------------------------------------------------- robust job tracking --
# Submit a job and echo its CUPS request id (e.g. "L3250_Series-42").
submit_job() {  # $1.. = extra lp options; FILE is used implicitly
    local out
    out=$(lp -d "$PRINTER" "$@" -- "$FILE") || return 1
    echo "$out" | sed -n 's/^request id is \([^ ]*\).*/\1/p'
}

# Wait for OUR job (not just any queue activity) to finish printing.
# Returns: 0 = printed & printer idle, 2 = job vanished (canceled/aborted?),
#          1 = timeout
wait_for_job() {  # $1 = request id
    local id="$1" t=0

    # Phase 1: wait until our job leaves the ACTIVE list. Polling only our
    # request id means other users' jobs on the same queue can't confuse us.
    while lpstat -o "$PRINTER" 2>/dev/null | grep -q "^$id "; do
        sleep 2; t=$((t+2))
        [ $t -ge 3600 ] && return 1
    done

    # Phase 2: distinguish completion from cancellation. A job that left
    # the active list without entering the completed collection was most
    # likely canceled or aborted.
    if ! lpstat -W completed -o "$PRINTER" 2>/dev/null | grep -q "^$id "; then
        return 2
    fi

    # Phase 3: an empty queue does NOT mean the last page has physically
    # exited — the backend may have handed data off while the printer is
    # still churning. Wait until the printer reports itself idle (USB
    # backends like Epson's report busy/printing state), with a timeout
    # for printers that don't report state reliably.
    t=0
    while lpstat -p "$PRINTER" 2>/dev/null | grep -Eq 'now printing| busy'; do
        sleep 2; t=$((t+2))
        [ $t -ge 600 ] && break
    done
    sleep 2   # settle
    return 0
}

# ---------------------------------------------------------- pass 1: odds ---
JOB1=$(submit_job -o page-set=odd -o sides=one-sided -o copies=1)
if [ -z "$JOB1" ]; then
    dlg_error "Failed to submit the odd-page print job."
    exit 1
fi

# --------------------------------------------- wait until printer is done --
notify "Printing odd pages…" 5
wait_for_job "$JOB1"
case $? in
    0) : ;;  # printed, printer idle
    2) if ! dlg_yesno "The odd-page job ('$JOB1') left the queue abnormally —\nwas it canceled or did printing fail?\n\nContinue to the flip step only if the odd pages did print correctly.\n\nContinue?"; then
           exit 1
       fi ;;
    *) if ! dlg_yesno "Timed out waiting for the odd-page job to finish.\n\nContinue to the flip step only if the odd pages printed correctly.\n\nContinue?"; then
           exit 1
       fi ;;
esac

# ----------------------------------------------------------- flip prompt ---
if ! dlg_yesno "Odd pages are done.\n\nNow:\n1. Take the whole stack from the output tray AS IS (do not reorder).\n2. $FLIP\n3. Put it back in the feed tray, printed side facing the way your printer expects (blank side toward the print head), top edge up.\n\nClick Yes when the paper is loaded — even pages will print.\nClick No to cancel (the backs will not be printed)."; then
    exit 0
fi

# --------------------------------------------------------- pass 2: evens ---
JOB2=$(submit_job -o page-set=even -o sides=one-sided -o copies=1)
if [ -z "$JOB2" ]; then
    dlg_error "Failed to submit the even-page print job."
    exit 1
fi

notify "Printing even pages on the backs. Done!" 8
